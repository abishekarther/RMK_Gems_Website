# RMK Gems API Configuration
PROJECT_NAME="RMK Gems API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration (defaults to local SQLite; override with PostgreSQL URL if available)
# Example PostgreSQL: postgresql+psycopg2://postgres:password@localhost:5432/rmk_gems
DATABASE_URL="sqlite:///./rmk_gems.db"

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Environment
ENVIRONMENT="development"
DEBUG=true

